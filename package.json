{
  "name": "lively-forms",
  "version": "0.1.0",
  "private": true,
  "description": "A conversational form builder inspired by Typeform.",
  "license": "AGPL-3.0-only",
  "author": "Michael Chernigin <michaelchernigin@gmail.com>",
  "homepage": "https://codeberg.org/chernigin/lively-forms",
  "bugs": {
    "url": "https://codeberg.org/chernigin/lively-forms/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://codeberg.org/chernigin/lively-forms.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/validate-translations.mjs && next build",
    "start": "next start",
    "test": "bun test",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check . --ignore-unknown",
    "check": "bun run format:check && bun test && bun run lint && bun run typecheck && bun run build",
    "hooks:install": "git config core.hooksPath .githooks",
    "db:up": "podman-compose up -d",
    "db:down": "podman-compose down",
    "db:logs": "podman-compose logs -f postgres",
    "db:reset": "podman-compose down -v && podman-compose up -d",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^28.0.1",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.3",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.2",
    "prisma": "7.7.0",
    "tailwindcss": "4.2.2",
    "typescript": "6.0.2"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.1",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@prisma/adapter-pg": "7.7.0",
    "@prisma/client": "7.7.0",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-select": "2.2.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "framer-motion": "12.38.0",
    "lucide-react": "1.8.0",
    "next": "16.2.3",
    "next-auth": "4.24.13",
    "pg": "8.20.0",
    "react": "19.2.5",
    "react-day-picker": "9.14.0",
    "react-dom": "19.2.5",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "3.5.0",
    "xlsx": "0.18.5",
    "yaml": "2.8.3",
    "zod": "4.3.6"
  }
}

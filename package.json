{
  "name": "chime",
  "version": "0.1.1",
  "private": true,
  "description": "A conversational form builder inspired by Typeform.",
  "license": "AGPL-3.0-only",
  "author": "Michael Chernigin <michaelchernigin@gmail.com>",
  "homepage": "https://github.com/bespoke-org/Chime",
  "bugs": {
    "url": "https://github.com/bespoke-org/Chime/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bespoke-org/Chime"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/validate-translations.mjs && next build",
    "start": "next start",
    "test": "bun test --isolate",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check . --ignore-unknown",
    "check": "bun run format:check && bun run test && bun run lint && bun run typecheck && bun run build",
    "hooks:install": "git config core.hooksPath .githooks",
    "db:up": "bash scripts/compose.sh up -d",
    "db:down": "bash scripts/compose.sh down",
    "db:logs": "bash scripts/compose.sh logs -f postgres",
    "db:reset": "bash scripts/compose.sh down -v && bash scripts/compose.sh up -d",
    "storage:init": "bash scripts/garage-init.sh",
    "uploads:cleanup": "bun run scripts/cleanup-uploads.ts",
    "webhooks:digest": "bun run scripts/run-digests.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate",
    "deploy": "bash scripts/deploy.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "4.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^28.0.1",
    "@types/node": "25.6.0",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.3",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.2",
    "prisma": "7.7.0",
    "tailwindcss": "4.2.2",
    "typescript": "6.0.2"
  },
  "dependencies": {
    "@atproto/api": "^0.20.41",
    "@atproto/oauth-client-node": "^0.5.3",
    "@auth/prisma-adapter": "2.11.1",
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@prisma/adapter-pg": "7.7.0",
    "@prisma/client": "7.7.0",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-select": "2.2.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "framer-motion": "12.38.0",
    "lucide-react": "1.8.0",
    "next": "16.2.3",
    "next-auth": "4.24.13",
    "nodemailer": "10.1.6",
    "pg": "8.20.0",
    "react": "19.2.5",
    "react-day-picker": "9.14.0",
    "react-dom": "19.2.5",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "3.5.0",
    "xlsx": "0.18.5",
    "yaml": "2.8.3",
    "zod": "4.3.6"
  }
}
